# SMTP Configuration
# Leave empty or comment out to run in DEMO MODE (emails printed to console only)

# SMTP Server Host
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (typically 587 for TLS or 465 for SSL)
SMTP_PORT=587

# SMTP Username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP Password (or app-specific password for Gmail)
SMTP_PASSWORD=your-app-password

# Serper API Key for artist research
SERPER_API_KEY=your-serper-api-key
